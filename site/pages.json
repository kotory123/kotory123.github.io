{
  "baseURL": "https://kotory123.github.io/",
  "enableGitInfo": false,
  "themesDir": "themes",
  "timeout": "120s",
  "security": {
    "exec": {
      "allow": [
        "^(dart-)?sass$",
        "^go$",
        "^git$",
        "^node$",
        "^postcss$",
        "^tailwindcss$",
        "^asciidoctor$"
      ]
    },
    "allowContent": [
      "^text/"
    ]
  },
  "theme": [
    "template"
  ],
  "title": "고영민 포트폴리오",
  "languageCode": "ko-KR",
  "defaultContentLanguage": "ko",
  "params": {
    "author": "고영민",
    "description": "전북대학교 고영민의 개인 포트폴리오 - 웹 프론트엔드와 전력 IT 프로젝트 기록",
    "defaultTheme": "auto"
  }
}
